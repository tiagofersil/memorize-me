{
  "expo": {
    "name": "Memorial Digital",
    "slug": "memorial-digital-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png", 
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4fd1c7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memorial.digital"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4fd1c7"
      },
      "package": "com.memorial.digital"
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "memorial-digital-mobile"
      }
    }
  }
}
